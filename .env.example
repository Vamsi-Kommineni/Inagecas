# Copy this file to `.env` and fill in real secrets before running.
# `.env` is gitignored. Never commit real credentials.

# ---------------------------------------------------------------------------
# General
# ---------------------------------------------------------------------------
INAGECAS_ENVIRONMENT=development
INAGECAS_LOG_LEVEL=INFO

# Comma-separated API keys accepted by the gateway. Generate strong random
# values, e.g.  python -c "import secrets; print(secrets.token_urlsafe(32))"
INAGECAS_API_KEYS=change-me-generate-a-real-key

# Optional shared secret required on calls between internal services. Leave
# empty to disable (services are already isolated to the internal network).
INAGECAS_INTERNAL_TOKEN=

# Comma-separated list of allowed CORS origins for browser clients.
INAGECAS_CORS_ORIGINS=http://localhost:3000

# ---------------------------------------------------------------------------
# Datastores (hostnames match the docker-compose service names)
# ---------------------------------------------------------------------------
POSTGRES_USER=inagecas
POSTGRES_PASSWORD=change-me-postgres-password
POSTGRES_DB=inagecas
INAGECAS_DATABASE_URL=postgresql+asyncpg://inagecas:change-me-postgres-password@postgres:5432/inagecas

INAGECAS_REDIS_URL=redis://redis:6379/0

INAGECAS_QDRANT_URL=http://qdrant:6333
INAGECAS_QDRANT_API_KEY=
INAGECAS_QDRANT_COLLECTION=inagecas_chunks

# ---------------------------------------------------------------------------
# Models (hosted primaries, local Ollama fallbacks, all routed through LiteLLM)
# ---------------------------------------------------------------------------
INAGECAS_MODEL_GATEWAY_URL=http://litellm:4000
INAGECAS_MODEL_GATEWAY_API_KEY=sk-change-me-litellm-master-key
LITELLM_MASTER_KEY=sk-change-me-litellm-master-key

# Logical model aliases defined in infra/litellm/config.yaml.
INAGECAS_CHAT_MODEL=chat
INAGECAS_JUDGE_MODEL=judge
# Set to "vision" to read screenshots with the vision model; empty means OCR only.
INAGECAS_VISION_MODEL=vision
INAGECAS_EMBED_MODEL=embed
INAGECAS_EMBED_DIM=768

# Retrieval reranking strategy: none | llm | cross_encoder
#   none          - fused/dense order, dense cosine as the score
#   llm           - the judge model scores each candidate (slower)
#   cross_encoder - local ONNX cross-encoder via fastembed (recommended)
INAGECAS_RERANK_STRATEGY=cross_encoder
INAGECAS_CROSS_ENCODER_MODEL=Xenova/ms-marco-MiniLM-L-6-v2

# Hybrid retrieval: dense embeddings fused with sparse BM25 (lexical) search.
INAGECAS_HYBRID_ENABLED=true
INAGECAS_SPARSE_MODEL=Qdrant/bm25
INAGECAS_RETRIEVAL_CANDIDATE_K=30
# Flag chunks older than this many days as stale (0 disables).
INAGECAS_STALENESS_DAYS=0

# Which real model backs each alias. Model strings carry the LiteLLM provider
# prefix (groq/..., openrouter/..., ollama_chat/...). Each hosted primary has a
# local fallback that LiteLLM switches to when the provider fails or rate
# limits. Embeddings stay on Ollama so the vectors in Qdrant keep one geometry.
LITELLM_CHAT_MODEL=groq/openai/gpt-oss-120b
LITELLM_JUDGE_MODEL=groq/qwen/qwen3.8-27b
# OpenRouter's ":free" Inkling variants are gated to listed agentic apps; the
# paid "openrouter/thinkingmachines/inkling-small" works once the account has credits.
LITELLM_VISION_MODEL=openrouter/inclusionai/ling-3.0-flash-vl:free
LITELLM_EMBED_MODEL=ollama/nomic-embed-text
LITELLM_CHAT_FALLBACK=ollama_chat/llama3.2:3b
LITELLM_JUDGE_FALLBACK=ollama_chat/llama3.2:3b
LITELLM_VISION_FALLBACK=ollama_chat/gemma3:latest
OLLAMA_BASE_URL=http://ollama:11434

# Provider keys for the hosted primaries.
GROQ_API_KEY=
OPENROUTER_API_KEY=

# ---------------------------------------------------------------------------
# Retrieval & answering
# ---------------------------------------------------------------------------
INAGECAS_RETRIEVAL_TOP_K=5
INAGECAS_RETRIEVAL_MIN_SCORE=0.45
# Repeated questions reuse their retrieval result for this many seconds (0 disables).
INAGECAS_RETRIEVAL_CACHE_TTL=300
INAGECAS_ANSWER_TEMPERATURE=0.1
INAGECAS_ANSWER_MAX_TOKENS=512
INAGECAS_ANSWER_MIN_CONFIDENCE=0.5

# Answer validation: grounding check and clarifying-question mode.
INAGECAS_VALIDATION_ENABLED=true
# Refuse a draft that cites fewer than this share of its sentences.
INAGECAS_ANSWER_MIN_COVERAGE=0.5
INAGECAS_CLARIFICATION_ENABLED=true
INAGECAS_CLARIFICATION_BAND_LOW=0.35

# ---------------------------------------------------------------------------
# Policy & routing
# ---------------------------------------------------------------------------
INAGECAS_POLICY_ENABLED=true
INAGECAS_POLICY_CLASSIFY=true
# What to do with questions classified as sensitive: escalate | answer
INAGECAS_POLICY_SENSITIVE_ACTION=escalate

# ---------------------------------------------------------------------------
# Vision / multimodal
# ---------------------------------------------------------------------------
# Minimum mean OCR confidence and character count for an image to be "readable".
INAGECAS_VISION_MIN_CONFIDENCE=0.5
INAGECAS_VISION_MIN_CHARS=8
# Max decoded image size (bytes) the vision service will process.
INAGECAS_IMAGE_MAX_BYTES=6291456

# ---------------------------------------------------------------------------
# Internal service URLs (compose service names)
# ---------------------------------------------------------------------------
INAGECAS_RETRIEVAL_SERVICE_URL=http://retrieval-service:8000
INAGECAS_ANSWER_SERVICE_URL=http://answer-service:8000
INAGECAS_POLICY_SERVICE_URL=http://policy-service:8000
INAGECAS_VISION_SERVICE_URL=http://vision-service:8000
INAGECAS_ESCALATION_SERVICE_URL=http://escalation-service:8000

# Hand off unanswerable/sensitive cases to the human escalation queue.
INAGECAS_ESCALATION_ENABLED=true
# Put a three-sentence model-written briefing above the hand-off notes.
INAGECAS_ESCALATION_LLM_SUMMARY=false

# Request hardening (body cap is generous enough for a base64 screenshot)
INAGECAS_REQUEST_MAX_BYTES=8388608
INAGECAS_RATE_LIMIT=60/minute

# ---------------------------------------------------------------------------
# Telemetry (OpenTelemetry SDK reads these standard variables)
# ---------------------------------------------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf

# ---------------------------------------------------------------------------
# Dashboards
# ---------------------------------------------------------------------------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-grafana-password
